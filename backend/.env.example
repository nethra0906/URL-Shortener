# Copy this file to .env (or export the variables directly) before running the app.

# Path to the SQLite database file. Defaults to backend/urls.db.
# DATABASE_PATH=./urls.db

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to "*" (any origin) which is fine for local development only.
# ALLOWED_ORIGINS=http://localhost:3000

# Enables Flask's debugger and auto-reload. Never set this to true in production.
# FLASK_DEBUG=false

# Port the dev server listens on.
# PORT=5000
